{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-reviewer",
          "informationUri": "https://github.com/swasik/itsm-2026-template",
          "rules": [
            {
              "id": "disabled-certificate-verification",
              "name": "disabled-certificate-verification",
              "shortDescription": {
                "text": "disabled-certificate-verification"
              },
              "properties": {
                "tags": [
                  "CWE-295"
                ]
              }
            },
            {
              "id": "unsafe-yaml-loader",
              "name": "unsafe-yaml-loader",
              "shortDescription": {
                "text": "unsafe-yaml-loader"
              },
              "properties": {
                "tags": [
                  "CWE-502"
                ]
              }
            },
            {
              "id": "missing-ticket-ownership-check",
              "name": "missing-ticket-ownership-check",
              "shortDescription": {
                "text": "missing-ticket-ownership-check"
              },
              "properties": {
                "tags": [
                  "CWE-639"
                ]
              }
            },
            {
              "id": "unrestricted-customer-webhook",
              "name": "unrestricted-customer-webhook",
              "shortDescription": {
                "text": "unrestricted-customer-webhook"
              },
              "properties": {
                "tags": [
                  "CWE-918"
                ]
              }
            },
            {
              "id": "hardcoded-service-credential",
              "name": "hardcoded-service-credential",
              "shortDescription": {
                "text": "hardcoded-service-credential"
              },
              "properties": {
                "tags": [
                  "CWE-798",
                  "CWE-259"
                ]
              }
            },
            {
              "id": "obsolete-vulnerable-pin",
              "name": "obsolete-vulnerable-pin",
              "shortDescription": {
                "text": "obsolete-vulnerable-pin"
              },
              "properties": {
                "tags": [
                  "CWE-1104"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "disabled-certificate-verification",
          "level": "warning",
          "message": {
            "text": "The avatar download disables TLS certificate verification with verify=False. An internal certificate should be validated against the intended CA rather than accepting an unauthenticated peer."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/avatar_fetch.py"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "class": "insecure-transport"
          }
        },
        {
          "ruleId": "unsafe-yaml-loader",
          "level": "warning",
          "message": {
            "text": "Uploaded routing rules are passed to yaml.load with yaml.Loader, which permits Python object construction before the list check. Use a safe loader and validate the resulting schema."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/rules_loader.py"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "class": "deserialization"
          }
        },
        {
          "ruleId": "missing-ticket-ownership-check",
          "level": "warning",
          "message": {
            "text": "The function returns a ticket selected by its identifier without comparing ticket.requester with the logged-in customer. Knowledge of another customer's ticket id can expose that ticket."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/ticket_access.py"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 17
                }
              }
            }
          ],
          "properties": {
            "class": "access-control"
          }
        },
        {
          "ruleId": "unrestricted-customer-webhook",
          "level": "warning",
          "message": {
            "text": "A customer-registered callback URL is fetched by the server without validating destinations or redirects. It can target internal services or metadata endpoints; constrain the destination and enforce network egress policy."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/webhook_relay.py"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "class": "ssrf"
          }
        },
        {
          "ruleId": "hardcoded-service-credential",
          "level": "warning",
          "message": {
            "text": "A long-lived CMDB bearer credential is stored directly in configuration source. Obtain the credential from a secret store and rotate it instead of distributing it with code."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/cmdb_token.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-service-credential",
          "level": "warning",
          "message": {
            "text": "A GitHub access token is embedded in the source configuration used to open issues. Inject it through an appropriately scoped secret and rotate exposed credentials."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/github.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-service-credential",
          "level": "warning",
          "message": {
            "text": "The outgoing-mail account password is hardcoded in a committed configuration module. Load it from a secret store with access controls rather than keeping it in the repository."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/mailer.py"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 4
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "obsolete-vulnerable-pin",
          "level": "warning",
          "message": {
            "text": "fastapi 0.65.1 is an old version that predates published security fixes. Upgrade to a supported patched release and verify compatibility with the application."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        },
        {
          "ruleId": "obsolete-vulnerable-pin",
          "level": "warning",
          "message": {
            "text": "urllib3 1.24.1 is a known-vulnerable legacy pin that predates subsequent security fixes. Replace it with a supported patched release rather than shipping this version."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        }
      ],
      "properties": {
        "model": "GPT-6 (Codex)",
        "route": "local",
        "model_self_reported": "GPT-6 (Codex, local interactive review)"
      }
    }
  ]
}
